<mxCell id="2 _title" value="&lt;b&gt;Inside MotionControl::moveLine() → moveHline()&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1100" height="34" as="geometry"/></mxCell>
<mxCell id="2 _sub" value="X-major case shown (|Δx| &amp;gt; |Δy|): X steps on every iteration, Y steps only when Bresenham says so.&amp;nbsp; moveVline() is the same flow with the X and Y roles swapped." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1380" height="24" as="geometry"/></mxCell>
<mxCell id="2 _IN" value="moveHline(x0, y0, x1, y1)&lt;br&gt;float, mm — e.g. (0, 0, 10, 5)" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fontFamily=Courier New;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="2 _Q1" value="&lt;b&gt;set direction and enable&lt;/b&gt;&lt;br&gt;X DIR = (x0 &amp;lt; x1),&amp;nbsp; Y DIR = (y0 &amp;lt; y1)&lt;br&gt;enable() X, Y1 → EN LOW" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="184" width="300" height="66" as="geometry"/></mxCell>
<mxCell id="2 _HW1" value="&lt;b&gt;DIR pins 7 (X) / 6 (Y)&lt;/b&gt;&lt;br&gt;EN pins 3 / 4 / 5" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="260" height="54" as="geometry"/></mxCell>
<mxCell id="2 _Q2" value="convertToSteps() on x0, x1, y0, y1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="300" height="46" as="geometry"/></mxCell>
<mxCell id="2 _CV" value="&lt;b&gt;convertToSteps(v)&lt;/b&gt;&lt;br&gt;CURRENT_UNIT 0 → round(v × 1600)&lt;br&gt;CURRENT_UNIT 1 → round(v × 2032)&lt;br&gt;otherwise → v (already steps)&lt;br&gt;returns int (16-bit on the Nano)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="253" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="2 _G" value="&lt;b&gt;globals.cpp&lt;/b&gt;&lt;br&gt;CURRENT_UNIT = 0&amp;nbsp; (mm)&lt;br&gt;STEPS_PER_MM = 1600&lt;br&gt;STEPS_PER_INCH = 2032&lt;br&gt;FEEDRATE = 1000 mm/min&lt;br&gt;ACCELERATION = 100 mm/s²" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="2 _DA2" value="long x_0, x_1, y_0, y_1&amp;nbsp; (steps)&lt;br&gt;e.g. X10 mm → 16000 steps" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fontFamily=Courier New;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="356" width="340" height="52" as="geometry"/></mxCell>
<mxCell id="2 _Q3" value="&lt;b&gt;speed-profile numbers&lt;/b&gt;&lt;br&gt;Vmax = FEEDRATE / 60 × STEPS_PER_MM&amp;nbsp;  [steps/s]&lt;br&gt;acc = ACCELERATION × STEPS_PER_MM&amp;nbsp;  [steps/s²]&lt;br&gt;iacc = idcc = Vmax² / (2·acc)&amp;nbsp;  [steps to reach Vmax]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="438" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="2 _EX" value="&lt;b&gt;with the defaults:&lt;/b&gt;&lt;br&gt;Vmax ≈ 26,667 steps/s&amp;nbsp; →&amp;nbsp; dt ≈ 37.5 µs&lt;br&gt;acc = 160,000 steps/s²&lt;br&gt;iacc ≈ 2,222 steps ≈ 1.39 mm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontColor=#333333;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="440" width="280" height="86" as="geometry"/></mxCell>
<mxCell id="2 _D1" value="x_0 &amp;gt; x_1 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="558" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="2 _SW" value="swap start ↔ end point&lt;br&gt;(line is drawn from the other end)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="573" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="2 _Q4" value="dx = x_1 − x_0&amp;nbsp; &amp;nbsp; &amp;nbsp; dy = |y_1 − y_0|&lt;br&gt;dir = +1 or −1&amp;nbsp; (sign of the y change)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="300" height="56" as="geometry"/></mxCell>
<mxCell id="2 _D2" value="dx &amp;lt; iacc + idcc ?&lt;br&gt;(too short to&lt;br&gt;reach Vmax)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="445" y="756" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="2 _TRI" value="&lt;b&gt;triangle profile&lt;/b&gt;&lt;br&gt;iacc = idcc = dx / 2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="781" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="2 _D3" value="dx ≠ 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="906" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="2 _END" value="&lt;b&gt;finish&lt;/b&gt;&lt;br&gt;disable() X and Y1 → EN HIGH&lt;br&gt;return to Processor → loop()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="909" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="2 _Q5" value="&lt;b&gt;init Bresenham&lt;/b&gt;&lt;br&gt;y = y_0,&amp;nbsp;  yPrev = y&lt;br&gt;D = 2·dy − dx,&amp;nbsp;  i = 0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="1012" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="2 _D4" value="i ≤ dx ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="1112" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="2 _D5" value="which part&lt;br&gt;of the move?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="1222" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="2 _ACC" value="&lt;b&gt;accelerate&amp;nbsp;  (i &amp;lt; iacc − 1)&lt;/b&gt;&lt;br&gt;v = √(2·acc·(i + 1))" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="150" y="1352" width="240" height="64" as="geometry"/></mxCell>
<mxCell id="2 _CRU" value="&lt;b&gt;cruise&lt;/b&gt;&lt;br&gt;v = Vmax" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="450" y="1352" width="240" height="64" as="geometry"/></mxCell>
<mxCell id="2 _DEC" value="&lt;b&gt;decelerate&amp;nbsp;  (i &amp;gt; dx − idcc − 1)&lt;/b&gt;&lt;br&gt;v = √(2·acc·(dx − i + 1))" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="1352" width="240" height="64" as="geometry"/></mxCell>
<mxCell id="2 _DT" value="dt = round(1,000,000 / v)&amp;nbsp;  [µs]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="1450" width="300" height="46" as="geometry"/></mxCell>
<mxCell id="2 _PRO" value="cruise at Vmax" style="shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=60;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1302" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="2 _PROa" value="accelerate" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1010" y="1320" width="76" height="24" as="geometry"/></mxCell>
<mxCell id="2 _PROd" value="decelerate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1394" y="1320" width="80" height="24" as="geometry"/></mxCell>
<mxCell id="2 _PROt" value="&lt;b&gt;speed v vs. step i&amp;nbsp; (trapezoid)&lt;/b&gt;&lt;br&gt;accelerate · cruise at Vmax · decelerate&lt;br&gt;short moves become a triangle" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1060" y="1380" width="360" height="56" as="geometry"/></mxCell>
<mxCell id="2 _PROh" value="v = √(2·a·s) follows from v² = 2·a·s&amp;nbsp; (ST AN2044 in the repo)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1060" y="1270" width="360" height="24" as="geometry"/></mxCell>
<mxCell id="2 _Q6" value="moveTo(x_0, x_0 + i, yPrev, y, dt)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="1526" width="300" height="46" as="geometry"/></mxCell>
<mxCell id="2 _D6" value="X moved?&lt;br&gt;(i &amp;gt; 0)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="1602" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="2 _SX" value="motorX.SingleStep(dt)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="1615" width="260" height="50" as="geometry"/></mxCell>
<mxCell id="2 _D7" value="Y changed?&lt;br&gt;(yPrev ≠ y)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="1718" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="2 _SY" value="&lt;b&gt;motorY1.SingleStep(dt)&lt;/b&gt;&lt;br&gt;STEP pin 8 is shared →&lt;br&gt;Y1 and Y2 both step" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="1726" width="260" height="60" as="geometry"/></mxCell>
<mxCell id="2 _Q7" value="&lt;b&gt;Bresenham update&lt;/b&gt;&lt;br&gt;yPrev = y&lt;br&gt;if D ≥ 0:&amp;nbsp;  y += dir,&amp;nbsp;  D −= 2·dx&lt;br&gt;D += 2·dy,&amp;nbsp; &amp;nbsp; i++" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="1834" width="300" height="86" as="geometry"/></mxCell>
<mxCell id="2 _SS" value="&lt;b&gt;StepperMotor::SingleStep(dt)&lt;/b&gt;&lt;br&gt;enable() → EN LOW&lt;br&gt;STEP HIGH,&amp;nbsp; delayMicroseconds(dt)&lt;br&gt;STEP LOW,&amp;nbsp; delayMicroseconds(dt)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="1670" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="2 _HW2" value="&lt;b&gt;STEP pin 9 (X) / pin 8 (Y1 + Y2)&lt;/b&gt;&lt;br&gt;→ TMC2209 → motor moves&lt;br&gt;one microstep" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="1800" width="260" height="66" as="geometry"/></mxCell>
<mxCell id="2 _issues" value="&lt;b&gt;KNOWN ISSUES&amp;nbsp; (layer “Known issues”)&lt;/b&gt;&lt;br&gt;&lt;br&gt;8&amp;nbsp; convertToSteps() returns a 16-bit int:&lt;br&gt;&amp;nbsp; &amp;nbsp; anything over 32,767 steps (~20.48 mm)&lt;br&gt;&amp;nbsp; &amp;nbsp; wraps to a wrong value.&lt;br&gt;&lt;br&gt;9&amp;nbsp; Each step takes 2·dt, and when both axes&lt;br&gt;&amp;nbsp; &amp;nbsp; step, X and Y pulse one after the other →&lt;br&gt;&amp;nbsp; &amp;nbsp; real speed is below the requested F.&lt;br&gt;&lt;br&gt;10&amp;nbsp; finish disables X and Y1 only — Y2&amp;#x27;s&lt;br&gt;&amp;nbsp; &amp;nbsp; enable pin (5) is left LOW (motor on)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontColor=#333333;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="bugs"><mxGeometry x="1460" y="100" width="330" height="200" as="geometry"/></mxCell>
